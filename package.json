{
    "name": "ioredfour",
    "version": "1.4.4",
    "description": "A redis binary semaphore with some consistency",
    "main": "lib/ioredfour.js",
    "scripts": {
        "test": "node --test --test-force-exit test/*-test.js",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module npm test",
        "test:cluster": "TEST_TARGET=cluster node --test --test-force-exit test/*-test.js",
        "cluster:up": "scripts/redis-cluster.sh up",
        "cluster:down": "scripts/redis-cluster.sh down",
        "test:all": "TEST_TARGET=all node --test --test-force-exit test/*-test.js",
        "test:coverage": "c8 npm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nodemailer/ioredfour.git"
    },
    "keywords": [
        "redis",
        "semaphore",
        "mutex",
        "node"
    ],
    "author": "Mixmax <hello@mixmax.com> (https://mixmax.com/), Daniel Reus (https://github.com/dreusel)",
    "license": "MIT",
    "files": [
        "lib/",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "bugs": {
        "url": "https://github.com/nodemailer/ioredfour/issues"
    },
    "homepage": "https://github.com/nodemailer/ioredfour#readme",
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "prettier": "3.9.10"
    },
    "dependencies": {
        "ioredis": "6.0.0"
    }
}
